import React from 'react';
import { motion } from 'framer-motion';
import {
  Activity,
  Cpu,
  Zap,
  Layout,
  Command,
  Shield,
  Globe,
  Terminal,
  ArrowUpRight,
  TrendingUp,
  Box,
  Server
} from 'lucide-react';
import {
  AreaChart,
  Area,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
  BarChart,
  Bar,
  Cell
} from 'recharts';
import { cn } from '@/lib/utils';

const Dashboard: React.FC = () => {
  // Mock data for Rechsrts
  const telemetryData = [
    { name: '00:00', gpu: 12, memory: 45, latency: 24 },
    { name: '04:00', gpu: 18, memory: 48, latency: 22 },
    { name: '08:00', gpu: 45, memory: 52, latency: 28 },
    { name: '12:00', gpu: 85, memory: 65, latency: 35 },
    { name: '16:00', gpu: 65, memory: 60, latency: 30 },
    { name: '20:00', gpu: 35, memory: 55, latency: 25 },
    { name: '23:59', gpu: 15, memory: 48, latency: 24 },
  ];

  const nodes = [
    { id: 'localhost', name: 'Local Bridge', status: 'Check', load: 0, icon: Globe, color: 'text-blue-400' },
  ];

  const container = {
    hidden: { opacity: 0 },
    show: {
      opacity: 1,
      transition: {
        staggerChildren: 0.1
      }
    }
  };

  const item = {
    hidden: { opacity: 0, y: 20 },
    show: { opacity: 1, y: 0 }
  };

  return (
    <motion.div
      variants={container}
      initial="hidden"
      animate="show"
      className="space-y-8"
    >
      {/* Hero Header */}
      <div className="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <motion.div variants={item}>
          <h1 className="text-5xl font-outfit font-bold tracking-tight gradient-text mb-2">Dashboard</h1>
          <p className="text-slate-400 font-medium">Federation overview — servers, health, and performance.</p>
        </motion.div>

        <motion.div variants={item} className="flex gap-4">
          <div className="flex items-center gap-4 px-6 py-3 sota-card bg-white/[0.02]">
            <div className="text-right">
              <span className="block text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-1">Global Health</span>
              <span className="text-sm font-bold text-emerald-400">99.98% NOMINAL</span>
            </div>
            <div className="w-10 h-10 rounded-full border-2 border-emerald-500/20 flex items-center justify-center">
              <Activity className="w-5 h-5 text-emerald-400 animate-pulse" />
            </div>
          </div>
        </motion.div>
      </div>

      {/* Primary Metrics Grid */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { label: 'Active Nodes', val: '—', trend: 'from bridge', icon: Server, color: 'text-blue-400', bg: 'bg-blue-400/10' },
          { label: 'Bridge Latency', val: '—ms', trend: 'live', icon: BarChart, color: 'text-rose-400', bg: 'bg-rose-400/10' },
          { label: 'Servers Healthy', val: '—', trend: 'last check', icon: TrendingUp, color: 'text-amber-400', bg: 'bg-amber-400/10' },
          { label: 'Categories', val: '—', trend: 'registered', icon: Box, color: 'text-indigo-400', bg: 'bg-indigo-400/10' },
        ].map((stat, i) => (
          <motion.div key={i} variants={item} className="group cursor-pointer">
            <div className="sota-card p-6 h-full flex flex-col justify-between">
              <div className="sota-card-glow" />
              <div className="flex justify-between items-start mb-4">
                <div className={cn("p-2.5 rounded-xl", stat.bg)}>
                  <stat.icon size={20} className={stat.color} />
                </div>
                <div className="flex items-center gap-1 text-[10px] font-bold text-emerald-400 bg-emerald-400/10 px-1.5 py-0.5 rounded">
                  <ArrowUpRight size={10} />
                  {stat.trend}
                </div>
              </div>
              <div>
                <span className="block text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-1">{stat.label}</span>
                <span className="text-3xl font-bold font-outfit">{stat.val}</span>
              </div>
            </div>
          </motion.div>
        ))}
      </div>

      {/* Charts Section */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {/* Main Telemetry Chart */}
        <motion.div variants={item} className="lg:col-span-2 sota-card p-8">
          <div className="flex items-center justify-between mb-8">
            <div>
              <h3 className="text-lg font-bold font-outfit">Hardware Performance</h3>
              <p className="text-xs text-slate-500">GPU Load vs Machine Latency</p>
            </div>
            <div className="flex gap-4">
              <div className="flex items-center gap-2">
                <div className="w-2 h-2 rounded-full bg-blue-500" />
                <span className="text-[10px] font-bold uppercase text-slate-400">GPU</span>
              </div>
              <div className="flex items-center gap-2">
                <div className="w-2 h-2 rounded-full bg-rose-500" />
                <span className="text-[10px] font-bold uppercase text-slate-400">Latency</span>
              </div>
            </div>
          </div>

          <div className="h-[300px] w-full mt-4">
            <ResponsiveContainer width="100%" height="100%">
              <AreaChart data={telemetryData}>
                <defs>
                  <linearGradient id="colorGpu" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="5%" stopColor="#3b82f6" stopOpacity={0.3} />
                    <stop offset="95%" stopColor="#3b82f6" stopOpacity={0} />
                  </linearGradient>
                  <linearGradient id="colorLatency" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="5%" stopColor="#f43f5e" stopOpacity={0.3} />
                    <stop offset="95%" stopColor="#f43f5e" stopOpacity={0} />
                  </linearGradient>
                </defs>
                <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.03)" vertical={false} />
                <XAxis
                  dataKey="name"
                  axisLine={false}
                  tickLine={false}
                  tick={{ fill: '#475569', fontSize: 10 }}
                  dy={10}
                />
                <YAxis hide />
                <Tooltip
                  contentStyle={{
                    backgroundColor: '#0a0a0f',
                    border: '1px solid rgba(255,255,255,0.1)',
                    borderRadius: '12px',
                    fontSize: '11px'
                  }}
                  itemStyle={{ color: '#fff' }}
                />
                <Area type="monotone" dataKey="gpu" stroke="#3b82f6" strokeWidth={2} fillOpacity={1} fill="url(#colorGpu)" />
                <Area type="monotone" dataKey="latency" stroke="#f43f5e" strokeWidth={2} fillOpacity={1} fill="url(#colorLatency)" />
              </AreaChart>
            </ResponsiveContainer>
          </div>
        </motion.div>

        {/* Node Status Sidebar */}
        <motion.div variants={item} className="sota-card p-6 flex flex-col">
          <div className="flex items-center justify-between mb-6">
            <h3 className="text-lg font-bold font-outfit">Priority Nodes</h3>
            <Layout size={18} className="text-slate-500" />
          </div>

          <div className="flex-1 space-y-4 overflow-y-auto custom-scrollbar pr-2">
            {nodes.map(node => (
              <div key={node.id} className="p-4 rounded-xl bg-white/[0.02] border border-white/5 hover:bg-white/[0.04] transition-all group">
                <div className="flex items-center justify-between mb-3">
                  <div className="flex items-center gap-3">
                    <div className={cn("p-2 rounded-lg bg-white/5 transition-colors group-hover:bg-white/10", node.color)}>
                      <node.icon size={16} />
                    </div>
                    <div>
                      <h4 className="text-sm font-bold">{node.name}</h4>
                      <p className="text-[10px] text-slate-500 mono uppercase tracking-tighter">{node.id}</p>
                    </div>
                  </div>
                  <div className="text-right">
                    <span className="block text-xs font-bold text-slate-300 mb-1">{node.load}%</span>
                    <div className="w-12 h-1 bg-white/5 rounded-full overflow-hidden">
                      <div className={cn("h-full transition-all duration-1000", node.load > 80 ? "bg-rose-500" : "bg-blue-500")} style={{ width: `${node.load}%` }} />
                    </div>
                  </div>
                </div>
                <div className="flex items-center justify-between text-[10px] font-bold uppercase tracking-widest text-slate-500">
                  <span className="text-emerald-400/80">{node.status}</span>
                  <button className="text-blue-400 hover:text-blue-300 transition-colors">Details</button>
                </div>
              </div>
            ))}
          </div>

          <div className="mt-6 pt-6 border-t border-white/5">
            <button className="w-full py-2.5 rounded-xl bg-blue-500/10 text-blue-400 text-xs font-bold uppercase tracking-widest border border-blue-500/20 hover:bg-blue-500/20 transition-all">
              Full Infrastructure View
            </button>
          </div>
        </motion.div>
      </div>

      {/* Footer Info / Log Preview */}
      <motion.div variants={item} className="grid grid-cols-1 lg:grid-cols-2 gap-6 pb-8">
        <div className="sota-card p-6 border-blue-500/10">
          <div className="flex items-center gap-3 mb-4">
            <Terminal size={18} className="text-blue-500" />
            <h3 className="text-sm font-bold uppercase tracking-widest">Bridge Status</h3>
          </div>
          <p className="text-[11px] text-slate-400 leading-relaxed mono">
            Bridge: http://localhost:10857 — check /health for live status.<br />
            Dashboard: http://localhost:10856<br />
            See Health page for per-server status.
          </p>
        </div>
        <div className="sota-card p-6 border-rose-500/10">
          <div className="flex items-center gap-3 mb-4">
            <Zap size={18} className="text-rose-500" />
            <h3 className="text-sm font-bold uppercase tracking-widest">Quick Links</h3>
          </div>
          <div className="space-y-2 text-[11px]">
            <a href="http://localhost:10857/redoc" target="_blank" rel="noopener noreferrer" className="block text-blue-400 hover:underline">Bridge API Docs → /redoc</a>
            <a href="http://localhost:10857/api/v1/servers" target="_blank" rel="noopener noreferrer" className="block text-blue-400 hover:underline">Server List JSON → /api/v1/servers</a>
            <a href="http://localhost:10857/api/v1/federation/health" target="_blank" rel="noopener noreferrer" className="block text-blue-400 hover:underline">Federation Health → /api/v1/federation/health</a>
          </div>
        </div>
      </motion.div>
    </motion.div>

    },
    {
      id: 'W-03',
      name: 'The Bastion Core',
      type: 'Secure Environment',
      population: 2,
      status: 'Secured',
      load: 85,
      tags: ['Security', 'Isolated'],
      color: 'text-rose-400',
      bg: 'bg-rose-400/10'
    },

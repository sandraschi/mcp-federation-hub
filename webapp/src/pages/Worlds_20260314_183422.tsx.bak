      tags: ['Social', 'Research'],
      color: 'text-blue-400',
      bg: 'bg-blue-400/10'
    },
    {
      id: 'W-02',
      name: 'Cybernetic Garden',
      type: 'Simulation',
      population: 0,
      status: 'Standby',
      load: 0,
      tags: ['Aesthetics', 'Testbed'],

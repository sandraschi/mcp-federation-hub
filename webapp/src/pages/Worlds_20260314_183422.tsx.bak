              {/* World Visual Placeholder */}
              <div className="h-40 bg-slate-900 relative overflow-hidden group-hover:bg-slate-800 transition-colors">
                <div className="absolute inset-0 opacity-20 group-hover:opacity-40 transition-opacity flex items-center justify-center">

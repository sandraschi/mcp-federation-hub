        <div className="flex gap-4">
          <button className="flex items-center gap-2 px-6 py-3 rounded-2xl bg-white/5 border border-white/10 text-slate-300 font-bold uppercase tracking-widest hover:bg-white/10 transition-all">
            <Compass size={18} />

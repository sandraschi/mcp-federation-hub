                    {world.status}
                  </span>
                </div>
                <div className="absolute bottom-4 left-4 flex gap-2">
                  {world.tags.map(tag => (
                    <span key={tag} className="text-[9px] font-bold px-1.5 py-0.5 rounded bg-white/10 text-slate-300 uppercase tracking-widest">

import React, { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import {
    Brain,
    Cpu,
    Activity,
    Bot,
    Database,
    Gauge,
    RefreshCw,
    ExternalLink,
    AlertCircle,
    Zap
} from 'lucide-react';
import {
    AreaChart,
    Area,
    XAxis,
    CartesianGrid,
    Tooltip,
    ResponsiveContainer
} from 'recharts';
import { cn } from '@/lib/utils';

const BRIDGE_URL = 'http://localhost:10857';

interface AIProvider {
    name: string;
    type: string;
    available: boolean;
    note?: string;
}

const LocalAI: React.FC = () => {
    const [providers, setProviders] = useState<Record<string, any>>({});
    const [loadingProviders, setLoadingProviders] = useState(true);
    const [error, setError] = useState<string | null>(null);

    // Static GPU data — replace with real polling from nvml/ollama when bridge exposes it
    const gpuData = [
        { t: '10:00', load: 45, vram: 12 },
        { t: '10:05', load: 52, vram: 14 },
        { t: '10:10', load: 48, vram: 13 },
        { t: '10:15', load: 85, vram: 18 },
        { t: '10:20', load: 92, vram: 22 },
        { t: '10:25', load: 65, vram: 16 },
        { t: '10:30', load: 42, vram: 12 },
    ];

    // Known local models (static for now — bridge doesn't expose Ollama model list yet)
    const models = [
        { name: 'Gemma 3 27B', provider: 'Ollama', endpoint: 'http://localhost:11434', status: 'Check Ollama' },
        { name: 'Llama 3.3 70B', provider: 'Ollama', endpoint: 'http://localhost:11434', status: 'Check Ollama' },
        { name: 'LM Studio', provider: 'LM Studio', endpoint: 'http://localhost:1234', status: 'Check LM Studio' },
    ];

    const loadProviders = async () => {
        setLoadingProviders(true);
        setError(null);
        try {
            const res = await fetch(`${BRIDGE_URL}/api/v1/ai/providers`, { signal: AbortSignal.timeout(4000) });
            if (!res.ok) throw new Error(`${res.status}`);
            const data = await res.json();
            setProviders(data.providers || {});
        } catch (e: any) {
            setError('Bridge unreachable: ' + e.message);
        } finally {
            setLoadingProviders(false);
        }
    };

    useEffect(() => { loadProviders(); }, []);

    return (
        <div className="space-y-8 animate-in">
            {/* Header */}
            <div className="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div>
                    <h1 className="text-4xl font-outfit font-bold tracking-tight gradient-text">Local AI</h1>
                    <p className="text-slate-400 mt-1">GPU telemetry and local model registry (Ollama / LM Studio).</p>
                </div>
                <div className="flex items-center gap-4 px-5 py-3 sota-card">
                    <div className="text-right">
                        <span className="block text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-1">Local GPU</span>
                        <span className="text-sm font-bold text-blue-400 uppercase">RTX 4090 · 24 GB VRAM</span>
                    </div>
                    <Cpu className="w-8 h-8 text-blue-400" />
                </div>
            </div>

            {error && (
                <div className="flex items-center gap-3 p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm">
                    <AlertCircle size={15} /> {error}
                </div>
            )}

            {/* GPU metrics */}
            <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div className="sota-card p-6">
                    <div className="flex items-center justify-between mb-4">
                        <Gauge size={20} className="text-blue-400" />
                        <span className="text-[10px] font-bold uppercase tracking-widest text-slate-500">GPU Utilization</span>
                    </div>
                    <h3 className="text-3xl font-bold font-outfit mb-2">—%</h3>
                    <p className="text-[11px] text-slate-500">Connect nvidia-smi bridge for live data</p>
                </div>

                <div className="sota-card p-6">
                    <div className="flex items-center justify-between mb-4">
                        <Database size={20} className="text-amber-400" />
                        <span className="text-[10px] font-bold uppercase tracking-widest text-slate-500">VRAM Used</span>
                    </div>
                    <h3 className="text-3xl font-bold font-outfit mb-2">— GB <span className="text-sm font-normal text-slate-500">/ 24 GB</span></h3>
                    <p className="text-[11px] text-slate-500">Check Ollama: <code className="text-blue-400">ollama ps</code></p>
                </div>

                <div className="sota-card p-6">
                    <div className="flex items-center justify-between mb-4">
                        <Brain size={20} className="text-indigo-400" />
                        <span className="text-[10px] font-bold uppercase tracking-widest text-slate-500">AI Providers (bridge)</span>
                    </div>
                    <h3 className="text-3xl font-bold font-outfit mb-2">
                        {loadingProviders ? '…' : Object.keys(providers).length}
                    </h3>
                    <p className="text-[11px] text-slate-500">Reported by bridge /api/v1/ai/providers</p>
                </div>
            </div>

            <div className="grid grid-cols-1 lg:grid-cols-5 gap-8">
                {/* GPU chart */}
                <div className="lg:col-span-3 sota-card p-8">
                    <div className="flex items-center justify-between mb-6">
                        <div className="flex items-center gap-3">
                            <Activity size={18} className="text-blue-400" />
                            <h3 className="text-lg font-bold font-outfit">GPU Load (sample data)</h3>
                        </div>
                        <span className="text-[10px] text-slate-500 font-bold uppercase tracking-wider">Replace with live polling</span>
                    </div>
                    <div className="h-[280px]">
                        <ResponsiveContainer width="100%" height="100%">
                            <AreaChart data={gpuData}>
                                <defs>
                                    <linearGradient id="gpuGrad" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="5%" stopColor="#3b82f6" stopOpacity={0.2} />
                                        <stop offset="95%" stopColor="#3b82f6" stopOpacity={0} />
                                    </linearGradient>
                                </defs>
                                <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.03)" vertical={false} />
                                <XAxis dataKey="t" axisLine={false} tickLine={false} tick={{ fill: '#475569', fontSize: 10 }} dy={8} />
                                <Tooltip contentStyle={{ backgroundColor: '#0a0a0f', border: '1px solid rgba(255,255,255,0.1)', borderRadius: '12px', fontSize: '11px' }} />
                                <Area type="step" dataKey="load" stroke="#3b82f6" strokeWidth={2} fillOpacity={1} fill="url(#gpuGrad)" />
                            </AreaChart>
                        </ResponsiveContainer>
                    </div>
                </div>

                {/* Model registry */}
                <div className="lg:col-span-2 sota-card p-6">
                    <div className="flex items-center justify-between mb-6">
                        <div className="flex items-center gap-3">
                            <Bot size={18} className="text-indigo-400" />
                            <h3 className="text-lg font-bold font-outfit">Local Models</h3>
                        </div>
                        <button onClick={loadProviders} className="text-slate-500 hover:text-white transition-colors">
                            <RefreshCw size={14} />
                        </button>
                    </div>

                    <div className="space-y-3 mb-6">
                        {models.map((m, i) => (
                            <div key={i} className="p-4 rounded-xl bg-white/[0.02] border border-white/5 hover:border-indigo-500/20 transition-all">
                                <div className="flex items-center justify-between mb-2">
                                    <div className="flex items-center gap-2">
                                        <Zap size={14} className="text-indigo-400" />
                                        <span className="text-sm font-bold text-slate-100">{m.name}</span>
                                    </div>
                                    <a href={m.endpoint} target="_blank" rel="noopener noreferrer" className="text-slate-600 hover:text-blue-400 transition-colors">
                                        <ExternalLink size={12} />
                                    </a>
                                </div>
                                <div className="flex items-center justify-between text-[10px] text-slate-500 mt-2">
                                    <span className="uppercase tracking-wider font-bold">{m.provider}</span>
                                    <span className="font-mono">{m.endpoint}</span>
                                </div>
                            </div>
                        ))}
                    </div>

                    {/* AI providers from bridge */}
                    {Object.keys(providers).length > 0 && (
                        <div className="border-t border-white/5 pt-4 space-y-2">
                            <span className="text-[10px] font-bold uppercase tracking-widest text-slate-500">Bridge AI Providers</span>
                            {Object.entries(providers).map(([key, val]: [string, any]) => (
                                <div key={key} className="flex items-center justify-between text-xs p-2 rounded-lg bg-white/[0.02]">
                                    <span className="text-slate-300 font-bold">{key}</span>
                                    <span className={cn("text-[10px] font-bold", val?.available ? 'text-emerald-400' : 'text-slate-500')}>
                                        {val?.available ? 'Available' : 'Not configured'}
                                    </span>
                                </div>
                            ))}
                        </div>
                    )}
                </div>
            </div>
        </div>
    );
};

export default LocalAI;

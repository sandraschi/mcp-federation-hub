import React, { useState } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import {
    Wrench,
    Search,
    Play,
    Terminal,
    Layout,
    Settings,
    Zap,
    Info,
    ChevronRight,
    Code2,
    CheckCircle2,
    XCircle,
    Clock,
    ExternalLink
} from 'lucide-react';
import { cn } from '@/lib/utils';

const Tools: React.FC = () => {
    const [selectedTool, setSelectedTool] = useState<string | null>('read_file');
    const [isExecuting, setIsExecuting] = useState(false);
    const [result, setResult] = useState<any>(null);

    const tools = [
        { id: 'read_file', name: 'read_file', description: 'Read a file from the local filesystem.', category: 'FileSystem' },
        { id: 'write_file', name: 'write_file', description: 'Write content to a file.', category: 'FileSystem' },
        { id: 'list_dir', name: 'list_directory', description: 'List contents of a directory.', category: 'FileSystem' },
        { id: 'send_osc', name: 'send_osc_message', description: 'Send an OSC packet to a remote host.', category: 'Communication' },
        { id: 'get_gpu', name: 'get_gpu_stats', description: 'Fetch real-time RTX telemetry.', category: 'System' },
    ];

    const handleExecute = () => {
        setIsExecuting(true);
        setResult(null);
        setTimeout(() => {
            setIsExecuting(false);
            setResult({
                status: 'success',
                data: {
                    content: "// SOTA Prototype Execution Result\nconsole.log('Orchestration complete');\nnode_status: 'NOMINAL',\nlatency: '12ms'",
                    executionTime: '240ms'
                }
            });
        }, 1500);
    };

    return (
        <div className="h-[calc(100vh-140px)] flex flex-col gap-6 animate-in">
            {/* Header */}
            <div className="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div>
                    <h1 className="text-4xl font-outfit font-bold tracking-tight gradient-text">Tools Lab</h1>
                    <p className="text-slate-400 mt-1">Execute and debug MCP server capabilities in a controlled environment.</p>
                </div>
            </div>

            <div className="flex-1 flex gap-8 overflow-hidden">
                {/* Tool Sidebar */}
                <div className="w-80 flex flex-col gap-4">
                    <div className="relative group">
                        <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-500" />
                        <input
                            type="text"
                            placeholder="Search tools..."
                            className="w-full h-10 pl-10 pr-4 bg-white/[0.02] border border-white/5 rounded-xl text-xs focus:outline-none focus:ring-1 focus:ring-blue-500/50"
                        />
                    </div>

                    <div className="flex-1 overflow-y-auto custom-scrollbar space-y-2 pr-2">
                        {tools.map(tool => (
                            <button
                                key={tool.id}
                                onClick={() => setSelectedTool(tool.id)}
                                className={cn(
                                    "w-full text-left p-4 rounded-2xl transition-all border group relative",
                                    selectedTool === tool.id
                                        ? "bg-blue-500/10 border-blue-500/20 text-white"
                                        : "bg-white/[0.01] border-white/5 text-slate-400 hover:bg-white/[0.04] hover:border-white/10"
                                )}
                            >
                                <div className="flex items-center justify-between mb-1">
                                    <span className="text-sm font-bold">{tool.name}</span>
                                    <ChevronRight size={14} className={cn("transition-transform", selectedTool === tool.id ? "rotate-90 text-blue-400" : "text-slate-600")} />
                                </div>
                                <p className="text-[10px] text-slate-500 line-clamp-1">{tool.description}</p>
                                {selectedTool === tool.id && <div className="absolute left-0 top-1/2 -translate-y-1/2 h-6 w-1 bg-blue-500 rounded-r-full shadow-[0_0_10px_rgba(56,189,248,0.5)]" />}
                            </button>
                        ))}
                    </div>
                </div>

                {/* Execution Area */}
                <div className="flex-1 flex flex-col gap-6 overflow-hidden">
                    {selectedTool ? (
                        <motion.div
                            key={selectedTool}
                            initial={{ opacity: 0, x: 20 }}
                            animate={{ opacity: 1, x: 0 }}
                            className="flex-1 flex flex-col gap-6"
                        >
                            {/* Parameter Editor */}
                            <div className="sota-card p-8 flex flex-col">
                                <div className="flex items-center justify-between mb-8">
                                    <div className="flex items-center gap-3">
                                        <div className="p-2.5 rounded-xl bg-blue-500/10 text-blue-400">
                                            <Wrench size={20} />
                                        </div>
                                        <div>
                                            <h2 className="text-xl font-bold font-outfit uppercase tracking-tighter">{selectedTool}</h2>
                                            <p className="text-xs text-slate-500">Configure parameters for execution</p>
                                        </div>
                                    </div>
                                    <div className="flex gap-2">
                                        <button className="flex items-center gap-2 px-4 py-2 rounded-xl bg-white/5 border border-white/10 text-xs font-bold text-slate-300 hover:bg-white/10">
                                            <Code2 size={14} />
                                            View Schema
                                        </button>
                                        <button
                                            onClick={handleExecute}
                                            disabled={isExecuting}
                                            className="flex items-center gap-2 px-6 py-2 rounded-xl bg-blue-500 text-white font-bold uppercase tracking-widest hover:bg-blue-600 transition-all shadow-xl active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed"
                                        >
                                            {isExecuting ? (
                                                <div className="w-4 h-4 border-2 border-white/20 border-t-white rounded-full animate-spin" />
                                            ) : (
                                                <Play size={14} fill="currentColor" />
                                            )}
                                            Execute Tool
                                        </button>
                                    </div>
                                </div>

                                <div className="space-y-6 flex-1 max-w-2xl">
                                    <div className="space-y-2">
                                        <label className="text-[10px] font-bold uppercase tracking-widest text-slate-500">Target Path (required)</label>
                                        <input
                                            type="text"
                                            placeholder="/absolute/path/to/target"
                                            className="w-full h-11 px-4 bg-white/[0.01] border border-white/5 rounded-xl text-sm font-mono text-blue-400 focus:outline-none focus:ring-1 focus:ring-blue-500/50 focus:bg-white/[0.03] transition-all"
                                        />
                                    </div>
                                    <div className="space-y-2">
                                        <label className="text-[10px] font-bold uppercase tracking-widest text-slate-500">Options (optional)</label>
                                        <div className="grid grid-cols-2 gap-4">
                                            <div className="p-4 rounded-xl bg-white/[0.01] border border-white/5 flex items-center justify-between">
                                                <span className="text-xs font-medium text-slate-300">Recursive</span>
                                                <div className="w-10 h-5 bg-blue-500/20 rounded-full relative flex items-center px-1 cursor-pointer">
                                                    <div className="w-3 h-3 bg-blue-400 rounded-full translate-x-5" />
                                                </div>
                                            </div>
                                            <div className="p-4 rounded-xl bg-white/[0.01] border border-white/5 flex items-center justify-between">
                                                <span className="text-xs font-medium text-slate-300">Ignore Dirs</span>
                                                <div className="w-10 h-5 bg-white/5 rounded-full relative flex items-center px-1 cursor-pointer">
                                                    <div className="w-3 h-3 bg-slate-600 rounded-full" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {/* Results Viewer */}
                            <div className="sota-card p-6 min-h-[300px] flex flex-col bg-black/20">
                                <div className="flex items-center justify-between mb-6">
                                    <div className="flex items-center gap-3">
                                        <Terminal size={18} className="text-slate-500" />
                                        <h3 className="text-xs font-bold uppercase tracking-[0.2em] text-slate-500">Execution Output</h3>
                                    </div>
                                    {result && (
                                        <div className="flex items-center gap-4">
                                            <div className="flex items-center gap-2">
                                                <Clock size={12} className="text-slate-500" />
                                                <span className="text-[10px] font-bold text-slate-500 mono">{result.data.executionTime}</span>
                                            </div>
                                            <div className="flex items-center gap-2 px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20">
                                                <CheckCircle2 size={12} className="text-emerald-400" />
                                                <span className="text-[10px] font-bold uppercase text-emerald-400">Success</span>
                                            </div>
                                        </div>
                                    )}
                                </div>

                                <div className="flex-1 bg-black/40 rounded-xl p-6 font-mono text-[13px] leading-relaxed border border-white/5 overflow-y-auto custom-scrollbar">
                                    {isExecuting ? (
                                        <div className="flex items-center gap-3 text-slate-500">
                                            <span className="text-blue-400 animate-pulse">&gt;</span>
                                            <span>Connecting to MCP substrate...</span>
                                        </div>
                                    ) : result ? (
                                        <pre className="text-blue-400/90">{result.data.content}</pre>
                                    ) : (
                                        <div className="h-full flex flex-col items-center justify-center text-slate-700 space-y-3">
                                            <Zap size={32} className="opacity-10" />
                                            <p className="text-xs uppercase tracking-widest font-bold opacity-30">Waiting for execution trigger</p>
                                        </div>
                                    )}
                                </div>
                            </div>
                        </motion.div>
                    ) : (
                        <div className="flex-1 sota-card flex flex-col items-center justify-center text-center space-y-6">
                            <div className="w-24 h-24 rounded-full bg-white/5 flex items-center justify-center text-slate-700 border border-dashed border-white/10">
                                <Settings size={48} />
                            </div>
                            <div>
                                <h2 className="text-2xl font-bold font-outfit text-slate-500">Select a tool to begin</h2>
                                <p className="text-slate-600 mt-2 max-w-sm">
                                    Choose an MCP capability from the left panel to configure its parameters and execute it within the SOTA orchestration layer.
                                </p>
                            </div>
                        </div>
                    )}
                </div>
            </div>
        </div>
    );
};

export default Tools;

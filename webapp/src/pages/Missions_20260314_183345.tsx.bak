import React from 'react';
import { motion } from 'framer-motion';
import {
    Zap,
    Activity,
    Clock,
    CheckCircle2,
    Circle,
    ArrowRight,
    Terminal,
    Play,
    RotateCcw,
    MoreVertical,
    Layers,
    Target
} from 'lucide-react';
import { cn } from '@/lib/utils';

const Missions: React.FC = () => {
    const missions = [
        {
            id: 'M-124',
            name: 'Fleet Synchronization',
            status: 'In Progress',
            progress: 65,
            steps: [
                { name: 'Node Discovery', status: 'complete' },
                { name: 'Token Handshake', status: 'complete' },
                { name: 'Entropy Balancing', status: 'active' },
                { name: 'Secure Tunneling', status: 'pending' },
            ]
        },
        {
            id: 'M-125',
            name: 'Security Audit v4',
            status: 'Standby',
            progress: 0,
            steps: [
                { name: 'Log Scrape', status: 'pending' },
                { name: 'Threat Synthesis', status: 'pending' },
            ]
        }
    ];

    return (
        <div className="space-y-8 animate-in">
            {/* Header */}
            <div className="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div>
                    <h1 className="text-4xl font-outfit font-bold tracking-tight gradient-text">Missions</h1>
                    <p className="text-slate-400 mt-1">High-level orchestration and federated goal execution.</p>
                </div>

                <button className="flex items-center gap-2 px-6 py-3 rounded-2xl bg-blue-500 text-white font-bold uppercase tracking-widest shadow-[0_0_20px_rgba(56,189,248,0.4)] hover:bg-blue-600 transition-all active:scale-95">
                    <Zap size={18} fill="currentColor" />
                    Initialize Mission
                </button>
            </div>

            {/* Active Missions Grid */}
            <div className="grid grid-cols-1 xl:grid-cols-2 gap-8">
                {missions.map((mission) => (
                    <motion.div
                        key={mission.id}
                        initial={{ opacity: 0, y: 20 }}
                        animate={{ opacity: 1, y: 0 }}
                        className="sota-card p-8 group"
                    >
                        <div className="sota-card-glow" />

                        <div className="flex items-center justify-between mb-8">
                            <div className="flex items-center gap-4">
                                <div className="w-12 h-12 rounded-2xl bg-blue-500/10 flex items-center justify-center text-blue-400 border border-blue-500/20">
                                    <Target size={24} />
                                </div>
                                <div>
                                    <h3 className="text-xl font-bold font-outfit">{mission.name}</h3>
                                    <p className="text-xs text-slate-500 mono uppercase tracking-widest">{mission.id} • Orchestration Phase</p>
                                </div>
                            </div>
                            <div className="flex gap-2">
                                <button
                                    className="p-2 rounded-lg text-slate-500 hover:text-white hover:bg-white/5 transition-all"
                                    title="Retry Mission"
                                    aria-label="Retry Mission"
                                >
                                    <RotateCcw size={16} />
                                </button>
                                <button
                                    className="p-2 rounded-lg text-slate-500 hover:text-white hover:bg-white/5 transition-all"
                                    title="More Options"
                                    aria-label="More Options"
                                >
                                    <MoreVertical size={16} />
                                </button>
                            </div>
                        </div>

                        {/* Stepper Visualization */}
                        <div className="space-y-6 mb-8">
                            {mission.steps.map((step, idx) => (
                                <div key={idx} className="flex items-center gap-4">
                                    <div className="flex flex-col items-center">
                                        <div className={cn(
                                            "w-6 h-6 rounded-full border-2 flex items-center justify-center transition-all duration-500",
                                            step.status === 'complete' ? "bg-emerald-500 border-emerald-500 text-white" :
                                                step.status === 'active' ? "border-blue-500 text-blue-500 animate-pulse" : "border-white/10 text-slate-700"
                                        )}>
                                            {step.status === 'complete' ? <CheckCircle2 size={12} /> : <Circle size={10} />}
                                        </div>
                                        {idx < mission.steps.length - 1 && (
                                            <div className={cn(
                                                "w-[2px] h-8 bg-white/5",
                                                step.status === 'complete' && "bg-emerald-500/30"
                                            )} />
                                        )}
                                    </div>
                                    <div className="flex-1 pb-4">
                                        <span className={cn(
                                            "text-sm font-bold",
                                            step.status === 'complete' ? "text-slate-200" :
                                                step.status === 'active' ? "text-blue-400" : "text-slate-600"
                                        )}>
                                            {step.name}
                                        </span>
                                        {step.status === 'active' && (
                                            <div className="mt-2 h-1 w-32 bg-white/5 rounded-full overflow-hidden">
                                                <motion.div
                                                    initial={{ x: "-100%" }}
                                                    animate={{ x: "100%" }}
                                                    transition={{ duration: 1.5, repeat: Infinity, ease: "linear" }}
                                                    className="w-full h-full bg-blue-500/50"
                                                />
                                            </div>
                                        )}
                                    </div>
                                </div>
                            ))}
                        </div>

                        <div className="pt-6 border-t border-white/5 flex items-center justify-between">
                            <div className="flex items-center gap-6">
                                <div>
                                    <span className="block text-[10px] uppercase font-bold text-slate-500 tracking-widest mb-1">Status</span>
                                    <span className={cn(
                                        "text-xs font-bold uppercase tracking-widest",
                                        mission.status === 'In Progress' ? "text-blue-400" : "text-slate-500"
                                    )}>{mission.status}</span>
                                </div>
                                <div>
                                    <span className="block text-[10px] uppercase font-bold text-slate-500 tracking-widest mb-1">Completion</span>
                                    <span className="text-xs font-bold text-slate-200">{mission.progress}%</span>
                                </div>
                            </div>

                            <button className="flex items-center gap-2 text-xs font-bold text-blue-400 hover:text-blue-300 transition-colors uppercase tracking-widest">
                                Detailed Trace
                                <ArrowRight size={14} />
                            </button>
                        </div>
                    </motion.div>
                ))}

                {/* Placeholder Mission Card */}
                <div className="sota-card p-8 border-dashed border-white/10 flex flex-col items-center justify-center text-center space-y-4 hover:border-blue-500/30 transition-all cursor-pointer bg-white/[0.01]">
                    <div className="w-16 h-16 rounded-full bg-white/5 flex items-center justify-center text-slate-600">
                        <Layers size={32} />
                    </div>
                    <div>
                        <h3 className="text-lg font-bold font-outfit text-slate-400">Deploy New Orchestration</h3>
                        <p className="text-xs text-slate-600 mt-1">Utilize AGENT_PROTOCOLS v13 to create dynamic goals.</p>
                    </div>
                </div>
            </div>

            {/* Terminal View / Recent Activity */}
            <div className="sota-card p-6">
                <div className="flex items-center gap-3 mb-4">
                    <Terminal size={18} className="text-slate-500" />
                    <h3 className="text-xs font-bold uppercase tracking-[0.2em] text-slate-500">Mission Stream Output</h3>
                </div>
                <div className="bg-black/40 rounded-xl p-4 font-mono text-[11px] text-blue-400/80 leading-relaxed border border-white/5">
                    <p>&gt; Starting discovery sweep for VR nodes...</p>
                    <p>&gt; Initializing SOTA handshake protocols...</p>
                    <p>&gt; <span className="text-emerald-400">Success:</span> Node "Vienna Hub" linked.</p>
                    <p>&gt; Balancing entropy flux across 4 nodes...</p>
                    <p className="animate-pulse">_</p>
                </div>
            </div>
        </div>
    );
};

export default Missions;

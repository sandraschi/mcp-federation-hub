import React from 'react';
import { motion } from 'framer-motion';
import {
    Server,
    Globe,
    Activity,
    Zap,
    Shield,
    Cpu,
    Wifi,
    Link2,
    MoreVertical,
    Plus,
    RefreshCw,
    Clock
} from 'lucide-react';
import { cn } from '@/lib/utils';

const Servers: React.FC = () => {
    const nodes = [
        { id: 'localhost', name: 'Local (this machine)', status: 'Check /health', latency: '—', cpu: 0, ram: 0, icon: Globe, color: 'text-blue-400' },
    ];

    return (
        <div className="space-y-8 animate-in">
            {/* Header */}
            <div className="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div>
                    <h1 className="text-4xl font-outfit font-bold tracking-tight gradient-text">Fleet Servers</h1>
                    <p className="text-slate-400 mt-1">Manage and monitor federated MCP nodes across the global substrate.</p>
                </div>

                <div className="flex gap-4">
                    <button className="flex items-center gap-2 px-6 py-3 rounded-2xl bg-white/5 border border-white/10 text-slate-300 font-bold uppercase tracking-widest hover:bg-white/10 transition-all">
                        <RefreshCw size={18} />
                        Refresh Nodes
                    </button>
                    <button className="flex items-center gap-2 px-6 py-3 rounded-2xl bg-blue-500 text-white font-bold uppercase tracking-widest shadow-[0_0_20px_rgba(56,189,248,0.4)] hover:bg-blue-600 transition-all">
                        <Plus size={18} />
                        Provision Node
                    </button>
                </div>
            </div>

            {/* Servers Grid */}
            <div className="grid grid-cols-1 md:grid-cols-2 2xl:grid-cols-4 gap-6">
                {nodes.map((node) => (
                    <motion.div
                        key={node.id}
                        initial={{ opacity: 0, scale: 0.95 }}
                        animate={{ opacity: 1, scale: 1 }}
                        className="group"
                    >
                        <div className="sota-card p-6 h-full flex flex-col">
                            <div className="sota-card-glow" />

                            <div className="flex justify-between items-start mb-6">
                                <div className={cn("p-3 rounded-xl bg-white/[0.03] transition-all group-hover:bg-white/[0.06] group-hover:scale-110", node.color)}>
                                    <node.icon size={24} />
                                </div>
                                <button className="p-2 rounded-lg text-slate-500 hover:text-white transition-all">
                                    <MoreVertical size={16} />
                                </button>
                            </div>

                            <div className="mb-6 flex-1">
                                <h3 className="text-lg font-bold font-outfit text-slate-100 group-hover:text-blue-400 transition-colors">{node.id}</h3>
                                <div className="flex items-center gap-2 text-xs text-slate-500 mt-1">
                                    <Wifi size={12} className="text-slate-600" />
                                    <span className="mono">{node.location}</span>
                                </div>
                            </div>

                            <div className="space-y-4 pt-6 border-t border-white/5">
                                <div className="flex items-center justify-between text-[10px] font-bold uppercase tracking-widest text-slate-500">
                                    <span>Latency</span>
                                    <span className="text-slate-300 mono">{node.latency}</span>
                                </div>
                                <div className="w-full h-1 bg-white/5 rounded-full overflow-hidden">
                                    <div className={cn("h-full transition-all duration-1000", node.latency.includes('ms') && parseInt(node.latency) > 100 ? "bg-rose-500" : "bg-blue-500")} style={{ width: '40%' }} />
                                </div>

                                <div className="grid grid-cols-2 gap-4">
                                    <div>
                                        <span className="block text-[9px] uppercase font-bold text-slate-500 mb-1">CPU Load</span>
                                        <span className="text-sm font-bold text-slate-200">{node.cpu}%</span>
                                    </div>
                                    <div className="text-right">
                                        <span className="block text-[9px] uppercase font-bold text-slate-500 mb-1">Status</span>
                                        <div className="flex items-center justify-end gap-1.5">
                                            <div className="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" />
                                            <span className="text-[10px] font-bold text-emerald-400 uppercase">{node.status}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <button className="w-full mt-6 py-2 rounded-xl bg-white/[0.02] border border-white/5 text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 hover:bg-blue-500/10 hover:text-blue-400 hover:border-blue-500/20 transition-all flex items-center justify-center gap-2 group/btn">
                                <Link2 size={12} className="group-hover/btn:rotate-45 transition-transform" />
                                Establish Tunnel
                            </button>
                        </div>
                    </motion.div>
                ))}
            </div>

            {/* Network Stats / Map Placeholder */}
            <div className="sota-card p-8 border-indigo-500/10 bg-indigo-500/[0.01]">
                <div className="flex items-center gap-3 mb-8">
                    <Activity size={20} className="text-indigo-400" />
                    <h3 className="text-lg font-bold font-outfit">Substrate Connectivity Matrix</h3>
                </div>

                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                    {[
                        { label: 'Active Tunnels', val: '12', trend: '+2' },
                        { label: 'Avg Fleet Latency', val: '42ms', trend: 'Stable' },
                        { label: 'Network Throughput', val: '4.2 TB/s', trend: '+5%' },
                        { label: 'Encryption Level', val: 'AES-256-SOTA', trend: 'Secure' },
                    ].map((stat, i) => (
                        <div key={i} className="space-y-2">
                            <span className="block text-[10px] font-bold uppercase tracking-widest text-slate-500">{stat.label}</span>
                            <div className="flex items-end gap-2">
                                <span className="text-2xl font-bold font-outfit text-slate-200">{stat.val}</span>
                                <span className="text-[10px] text-emerald-400 font-bold mb-1.5">{stat.trend}</span>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );

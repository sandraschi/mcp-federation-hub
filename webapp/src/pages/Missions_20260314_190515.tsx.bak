import React, { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import {
    Settings,
    RefreshCw,
    Save,
    Server,
    Globe,
    AlertCircle,
    CheckCircle2,
    ChevronDown,
    ChevronRight,
    Edit3,
    Plus,
    Trash2
} from 'lucide-react';
import { cn } from '@/lib/utils';

interface ServerEntry {
    id: string;
    name: string;
    description?: string;
    category?: string;
    tier?: string;
    mcp_endpoint?: string;
    health_endpoint?: string;
    web_interface?: string;
    status?: string;
}

interface FederationConfig {
    federation?: { name?: string; version?: string; ports?: { bridge?: number; dashboard?: number } };
    servers: Record<string, ServerEntry>;
    categories?: Record<string, string[]>;
}

import { federationApi } from '@/services/api';

const Config: React.FC = () => {
    const [config, setConfig] = useState<FederationConfig | null>(null);
    const [rawJson, setRawJson] = useState('');
    const [editMode, setEditMode] = useState(false);
    const [loading, setLoading] = useState(true);
    const [saving, setSaving] = useState(false);
    const [error, setError] = useState<string | null>(null);
    const [saved, setSaved] = useState(false);
    const [expandedServer, setExpandedServer] = useState<string | null>(null);

    const load = async () => {
        setLoading(true);
        setError(null);
        try {
            // Load raw config from bridge
            const [serversRes, healthRes] = await Promise.all([
                federationApi.getServers(),
                fetch('http://localhost:10857/health').then(r => r.json()).catch(() => null),
            ]);
            const servers: Record<string, any> = {};
            for (const s of serversRes.servers || []) servers[s.id] = s;
            const cfg: FederationConfig = {
                federation: healthRes?.federation
                    ? { ports: { bridge: 10857, dashboard: 10856 } }
                    : undefined,
                servers,
            };
            setConfig(cfg);
            setRawJson(JSON.stringify(cfg, null, 2));
        } catch (e: any) {
            setError(e.message);
        } finally {
            setLoading(false);
        }
    };

    useEffect(() => { load(); }, []);

    const handleSaveRaw = async () => {
        setSaving(true);
        setError(null);
        try {
            const parsed = JSON.parse(rawJson);  // validate first
            await federationApi.saveConfig(parsed, true);
            setSaved(true);
            setTimeout(() => setSaved(false), 2500);
            // Reload to reflect any normalisation the bridge did
            await load();
        } catch (e: any) {
            if (e.message?.includes('JSON')) {
                setError('Invalid JSON: ' + e.message);
            } else {
                setError('Save failed: ' + (e.response?.data?.detail ?? e.message));
            }
        } finally {
            setSaving(false);
        }
    };

    const servers = config ? Object.values(config.servers) : [];

    return (
        <div className="space-y-8 animate-in">
            {/* Header */}
            <div className="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div>
                    <h1 className="text-4xl font-outfit font-bold tracking-tight gradient-text">Federation Config</h1>
                    <p className="text-slate-400 mt-1">Registered MCP servers and federation settings.</p>
                </div>
                <div className="flex gap-3">
                    <button
                        onClick={load}
                        className="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white/5 border border-white/10 text-slate-300 text-sm font-bold hover:bg-white/10 transition-all"
                    >
                        <RefreshCw size={15} /> Reload
                    </button>
                    <button
                        onClick={() => setEditMode(!editMode)}
                        className={cn(
                            "flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold transition-all",
                            editMode
                                ? "bg-amber-500/10 border border-amber-500/30 text-amber-400"
                                : "bg-white/5 border border-white/10 text-slate-300 hover:bg-white/10"
                        )}
                    >
                        <Edit3 size={15} /> {editMode ? 'Cancel Edit' : 'Edit Raw JSON'}
                    </button>
                    {editMode && (
                        <button
                            onClick={handleSaveRaw}
                            disabled={saving}
                            className="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-500 text-white text-sm font-bold hover:bg-blue-600 transition-all disabled:opacity-50"
                        >
                            {saved ? <CheckCircle2 size={15} /> : <Save size={15} />}
                            {saved ? 'Saved' : saving ? 'Saving...' : 'Save'}
                        </button>
                    )}
                </div>
            </div>

            {error && (
                <div className="flex items-center gap-3 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm">
                    <AlertCircle size={16} />
                    {error}
                </div>
            )}

            {/* Stats */}
            <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                {[
                    { label: 'Registered Servers', val: servers.length },
                    { label: 'Categories', val: config?.categories ? Object.keys(config.categories).length : '—' },
                    { label: 'Bridge Port', val: config?.federation?.ports?.bridge ?? 10857 },
                    { label: 'Dashboard Port', val: config?.federation?.ports?.dashboard ?? 10856 },
                ].map((s, i) => (
                    <div key={i} className="sota-card p-4">
                        <span className="block text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-1">{s.label}</span>
                        <span className="text-2xl font-bold font-outfit">{loading ? '…' : s.val}</span>
                    </div>
                ))}
            </div>

            {editMode ? (
                /* Raw JSON editor */
                <div className="sota-card p-6">
                    <div className="flex items-center gap-2 mb-4">
                        <Settings size={16} className="text-amber-400" />
                        <span className="text-xs font-bold uppercase tracking-widest text-slate-400">Raw JSON (federation-config.json)</span>
                    </div>
                    <textarea
                        value={rawJson}
                        onChange={e => setRawJson(e.target.value)}
                        className="w-full h-[500px] bg-black/40 rounded-xl p-4 font-mono text-xs text-blue-400/90 border border-white/5 focus:outline-none focus:ring-1 focus:ring-blue-500/40 resize-none"
                        spellCheck={false}
                    />
                </div>
            ) : (
                /* Server list */
                <div className="sota-card divide-y divide-white/5">
                    {loading ? (
                        <div className="p-10 text-center text-slate-500 text-sm">Loading config from bridge...</div>
                    ) : servers.length === 0 ? (
                        <div className="p-10 text-center text-slate-500 text-sm">No servers registered. Check bridge connection.</div>
                    ) : (
                        servers.map((srv) => (
                            <div key={srv.id}>
                                <button
                                    onClick={() => setExpandedServer(expandedServer === srv.id ? null : srv.id)}
                                    className="w-full flex items-center gap-4 p-5 hover:bg-white/[0.02] transition-all text-left"
                                >
                                    <div className="p-2 rounded-lg bg-white/5 text-blue-400">
                                        <Server size={16} />
                                    </div>
                                    <div className="flex-1 min-w-0">
                                        <div className="flex items-center gap-3">
                                            <span className="font-bold text-slate-100">{srv.name || srv.id}</span>
                                            {srv.category && (
                                                <span className="text-[10px] font-bold px-1.5 py-0.5 rounded bg-blue-500/10 text-blue-400 uppercase tracking-tighter">
                                                    {srv.category}
                                                </span>
                                            )}
                                            {srv.tier && (
                                                <span className="text-[10px] font-bold px-1.5 py-0.5 rounded bg-white/5 text-slate-500 uppercase tracking-tighter">
                                                    {srv.tier}
                                                </span>
                                            )}
                                        </div>
                                        <p className="text-xs text-slate-500 mt-0.5 truncate">{srv.id}</p>
                                    </div>
                                    {expandedServer === srv.id ? <ChevronDown size={16} className="text-slate-500 shrink-0" /> : <ChevronRight size={16} className="text-slate-500 shrink-0" />}
                                </button>

                                {expandedServer === srv.id && (
                                    <div className="px-5 pb-5 ml-12 space-y-3">
                                        {srv.description && <p className="text-sm text-slate-400">{srv.description}</p>}
                                        <div className="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs font-mono">
                                            {srv.mcp_endpoint && (
                                                <div className="p-3 rounded-lg bg-black/30 border border-white/5">
                                                    <span className="text-slate-500 block mb-1 font-sans font-bold uppercase tracking-widest text-[9px]">MCP Endpoint</span>
                                                    <span className="text-blue-400">{srv.mcp_endpoint}</span>
                                                </div>
                                            )}
                                            {srv.health_endpoint && (
                                                <div className="p-3 rounded-lg bg-black/30 border border-white/5">
                                                    <span className="text-slate-500 block mb-1 font-sans font-bold uppercase tracking-widest text-[9px]">Health Endpoint</span>
                                                    <span className="text-emerald-400">{srv.health_endpoint}</span>
                                                </div>
                                            )}
                                            {srv.web_interface && (
                                                <div className="p-3 rounded-lg bg-black/30 border border-white/5">
                                                    <span className="text-slate-500 block mb-1 font-sans font-bold uppercase tracking-widest text-[9px]">Web Interface</span>
                                                    <a href={srv.web_interface} target="_blank" rel="noopener noreferrer" className="text-indigo-400 hover:underline">
                                                        {srv.web_interface}
                                                    </a>
                                                </div>
                                            )}
                                        </div>
                                    </div>
                                )}
                            </div>
                        ))
                    )}
                </div>
            )}
        </div>
    );
};

export default Config;

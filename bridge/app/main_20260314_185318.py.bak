# WorldLabs API routes
class WorldGenerationRequest(BaseModel):
    prompt: Optional[str] = None
    image_url: Optional[str] = None
    video_url: Optional[str] = None
    panorama_url: Optional[str] = None
    wait_for_completion: bool = True


class WorldDownloadRequest(BaseModel):
    world_id: str
    format: str = "gltf"
    output_path: Optional[str] = None


@app.post("/api/v1/worldlabs/generate")
async def generate_world_via_bridge(request: WorldGenerationRequest):
    """Generate a 3D world using WorldLabs API through the federation bridge"""
    # Route to WorldLabs MCP server
    server_config = federation_manager.get_server_config("worldlabs-mcp")
    if not server_config:
        raise HTTPException(
            status_code=404, detail="WorldLabs MCP server not found in federation"
        )

    mcp_endpoint = server_config.get("mcp_endpoint")
    if not mcp_endpoint:
        raise HTTPException(
            status_code=500, detail="WorldLabs MCP endpoint not configured"
        )

    # Construct tool call
    tool_args = {"wait_for_completion": request.wait_for_completion}

    if request.prompt:
        tool_name = "generate_world_from_text"
        tool_args["prompt"] = request.prompt
    elif request.image_url:
        tool_name = "generate_world_from_image"
        tool_args["image_url"] = request.image_url
    elif request.video_url:
        tool_name = "generate_world_from_video"
        tool_args["video_url"] = request.video_url
    else:
        raise HTTPException(
            status_code=400,
            detail="Must provide prompt, image_url, video_url, or panorama_url",
        )

    # Make MCP tool call
    mcp_request = {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {"name": tool_name, "arguments": tool_args},
    }

    try:
        async with httpx.AsyncClient(
            timeout=350.0
        ) as client:  # 5.5 min timeout for world generation
            response = await client.post(
                mcp_endpoint,
                json=mcp_request,
                headers={"Content-Type": "application/json"},
            )

            if response.status_code == 200:
                result = response.json()
                if result.get("result"):
                    # Parse the JSON string result from the MCP tool
                    try:
                        tool_result = json.loads(result["result"])
                        return tool_result
                    except Exception:
                        return {"raw_result": result["result"]}
                else:
                    return result
            else:
                raise HTTPException(
                    status_code=response.status_code,
                    detail=f"WorldLabs MCP error: {response.text}",
                )

    except httpx.TimeoutException:
        raise HTTPException(
            status_code=504, detail="World generation timeout - try again later"
        )
    except Exception as e:
        logger.error(f"Error calling WorldLabs MCP: {e}")
        raise HTTPException(
            status_code=500, detail=f"World generation failed: {str(e)}"
        )



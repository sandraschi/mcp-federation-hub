@app.get("/api/v1/servers/{server_id}/tools")
async def get_server_tools(server_id: str, refresh: bool = False):
    """
    Return tools available on a server by calling MCP tools/list.
    Results are cached for 5 minutes. Pass ?refresh=true to force.
    """
    server = federation_manager.get_server_config(server_id)
    if not server:
        raise HTTPException(status_code=404, detail=f"Server {server_id} not found")

    mcp_endpoint = server.get("mcp_endpoint")
    if not mcp_endpoint:
        return {"server_id": server_id, "tools": [], "note": "No mcp_endpoint configured"}

    if refresh:
        # Clear cache entry to force fresh fetch
        hmon._tool_cache_ts.pop(server_id, None)

    tools = await hmon.fetch_tools(server_id, mcp_endpoint)
    return {
        "server_id": server_id,
        "mcp_endpoint": mcp_endpoint,
        "tools": tools,
        "tool_count": len(tools),
        "cached": server_id in hmon._tool_cache_ts,
    }


@app.get("/api/v1/tools/all")
async def get_all_tools():
    """Return all cached tool lists across all servers."""
    cache = hmon.get_all_tool_cache()
    return {
        "servers": cache,
        "total_tools": sum(len(v) for v in cache.values()),
        "servers_with_tools": len(cache),
    }



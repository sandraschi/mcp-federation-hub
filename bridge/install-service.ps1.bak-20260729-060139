<#
.SYNOPSIS
    Install the MCP Federation Hub Bridge as a Windows service via NSSM.
.DESCRIPTION
    Registers a persistent Windows service that:
      - Auto-starts at boot
      - Restarts on failure
      - Runs the bridge headless (no console window)
      - Survives reboots and Docker Desktop flakiness

    NSSM (Non-Sucking Service Manager) is the recommended approach per
    fleet architecture decision (Docker Desktop is flaky on this host).

    Requirements: NSSM on PATH (the script can install it via winget).
#>

param(
    [string]$ServiceName = "mcp-federation-hub",
    [int]$BridgePort = 10857,
    [switch]$Remove,
    [switch]$RemoteAccess
)

$ErrorActionPreference = "Stop"
$BridgeDir = $PSScriptRoot
$DefaultBindHost = if ($RemoteAccess) { "0.0.0.0" } else { "127.0.0.1" }

# ---- nssm resolution -------------------------------------------------
$nssm = Get-Command nssm -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1
if (-not $nssm) {
    Write-Host "NSSM not found on PATH." -ForegroundColor Yellow
    $winget = Get-Command winget -ErrorAction SilentlyContinue | Select-Object -First 1
    if (-not $winget) {
        Write-Host "winget also not available. Install NSSM manually:" -ForegroundColor Red
        Write-Host "  winget install --id NSSM.NSSM" -ForegroundColor Yellow
        Write-Host "Then re-run this script." -ForegroundColor Yellow
        exit 1
    }
    Write-Host "Installing NSSM via winget ..." -ForegroundColor Cyan
    & winget install --id NSSM.NSSM --silent --accept-source-agreements --accept-package-agreements
    # Refresh PATH
    $env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" +
                [System.Environment]::GetEnvironmentVariable("Path", "User")
    $nssm = Get-Command nssm -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1
    if (-not $nssm) {
        Write-Host "NSSM still not found after install. Restart your shell." -ForegroundColor Red
        exit 1
    }
}

$NssmExe = $nssm.Source

# ---- removal ----------------------------------------------------------
if ($Remove) {
    Write-Host "Removing service '$ServiceName' ..." -ForegroundColor Cyan
    & $NssmExe stop    $ServiceName 2>$null
    & $NssmExe remove  $ServiceName confirm
    Write-Host "Service '$ServiceName' removed." -ForegroundColor Green
    exit 0
}

# ---- service wrapper script -------------------------------------------
$WrapperPath = Join-Path $BridgeDir "service-wrapper.ps1"
@"
# Auto-generated by install-service.ps1 — do not hand-edit
param([switch]`$Headless)
`$env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" +
            [System.Environment]::GetEnvironmentVariable("Path", "User")
Set-Location "$BridgeDir"

`$BridgePort = $BridgePort
`$BindHost = if (`$env:FLEET_BIND_HOST) { `$env:FLEET_BIND_HOST } else { "$DefaultBindHost" }

# Zombie kill loop — stale TIME_WAIT sockets can block for several seconds
for (`$i = 0; `$i -lt 5; `$i++) {
    `$zombies = netstat -ano | Select-String ":`${BridgePort} " | Select-String "LISTENING"
    if (-not `$zombies) { break }
    foreach (`$z in `$zombies) {
        `$zp = (`$z -split '\s+')[-1]
        taskkill /F /PID `$zp 2>`$null
    }
    Start-Sleep -Seconds 1
}

# Sync and start bridge directly with retry on transient errors
uv sync --quiet
for (`$attempt = 1; `$attempt -le 3; `$attempt++) {
    if (`$attempt -gt 1) {
        Write-Host "Retrying uvicorn (attempt `$attempt/3)..."
        Start-Sleep -Seconds 3
    }
    uv run uvicorn app.main:app --host `$BindHost --port `$BridgePort --log-level info
    if (`$LASTEXITCODE -eq 0) { exit 0 }
}
exit 1
"@ | Set-Content -LiteralPath $WrapperPath -Encoding UTF8
Write-Host "Service wrapper written: $WrapperPath" -ForegroundColor DarkGray

# ---- install ----------------------------------------------------------
Write-Host "Installing service '$ServiceName' ..." -ForegroundColor Cyan

# Stop + remove if already exists (idempotent)
& $NssmExe stop   $ServiceName 2>$null
Start-Sleep -Seconds 1
& $NssmExe remove $ServiceName confirm 2>$null

# Register
& $NssmExe install $ServiceName (Get-Command pwsh).Source
& $NssmExe set $ServiceName AppParameters "-NoProfile -ExecutionPolicy Bypass -File `"$WrapperPath`" -Headless"
& $NssmExe set $ServiceName AppDirectory $BridgeDir
& $NssmExe set $ServiceName DisplayName "MCP Federation Hub Bridge"
& $NssmExe set $ServiceName Description "MCP Federation Hub — fleet health monitor + supervisor (port $BridgePort)"
& $NssmExe set $ServiceName Start SERVICE_AUTO_START
& $NssmExe set $ServiceName AppExit Default Restart
& $NssmExe set $ServiceName AppRestartDelay 10000
if ($RemoteAccess) {
    & $NssmExe set $ServiceName AppEnvironmentExtra "FLEET_REMOTE_ACCESS=1" "FLEET_BIND_HOST=0.0.0.0"
    Write-Host "Remote access: bridge binds 0.0.0.0 — set FLEET_TOKEN for auth" -ForegroundColor Yellow
}

# Start
& $NssmExe start $ServiceName

Start-Sleep -Seconds 3

try {
    $status = (& $NssmExe status $ServiceName 2>&1) -join " "
} catch {
    $status = "unknown"
}

Write-Host ""
Write-Host "Service '$ServiceName' — $status" -ForegroundColor Green
Write-Host "  NSSM:      $NssmExe"
Write-Host "  Bridge:    http://localhost:$BridgePort (bind: $DefaultBindHost)"
Write-Host "  Wrapper:   $WrapperPath"
Write-Host ""
Write-Host "Useful commands:" -ForegroundColor DarkGray
Write-Host "  nssm status $ServiceName           # check status"
Write-Host "  nssm restart $ServiceName          # restart service"
Write-Host "  nssm stop $ServiceName             # stop service"
Write-Host "  .\install-service.ps1 -Remove      # uninstall"
